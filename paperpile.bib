@ARTICLE{Adenzato2019-sa,
  title        = {Transcranial direct current stimulation enhances theory of
                  mind in Parkinson's disease patients with mild cognitive
                  impairment: a randomized, double-blind, sham-controlled study},
  author       = {Adenzato, Mauro and Manenti, Rosa and Enrici, Ivan and Gobbi,
