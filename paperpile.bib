  issue        = {9},
  pages        = {465--470},
  date         = {2013-11},
  abstract     = {Brain implants, such as Deep Brain Stimulation (DBS), which
                  are designed to improve motor, mood and behavioural pathology,
                  present unique challenges to our understanding of identity,
