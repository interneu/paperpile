  author       = {Yashiro, Ryuto and Sato, Hiromi and Motoyoshi, Isamu},
  journaltitle = {Sci. Rep.},
  volume       = {9},
  issue        = {1},
  pages        = {3809},
  date         = {2019},
  abstract     = {Humans persist in their attempts to predict the future in
                  spite of the fact that natural events often involve a
                  fundamental element of uncertainty. The present study explored
                  computational mechanisms underlying biases in prospective
                  decision making by using a simple psychophysical task.
                  Observers viewed a randomly moving Gabor target for T sec and
