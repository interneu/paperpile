@ARTICLE{Schalbroeck2021-sb,
  title        = {Striatal dopamine synthesis capacity in autism spectrum
                  disorder and its relation with social defeat: an [18F]-{FDOPA}
                  {PET}/{CT} study},
  author       = {Schalbroeck, Rik and van Velden, Floris H P and de Geus-Oei,
