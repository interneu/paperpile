@ARTICLE{Neumann2023-yz,
  title        = {Insights and opportunities for deep brain stimulation as a
                  brain circuit intervention},
  author       = {Neumann, Wolf-Julian and Horn, Andreas and Kühn, Andrea A},
  journaltitle = {Trends Neurosci.},
  date         = {2023-04-25},
  abstract     = {Deep brain stimulation (DBS) is an effective treatment and has
                  provided unique insights into the dynamic circuit architecture
                  of brain disorders. This Review illustrates our current
                  understanding of the pathophysiology of movement disorders and
                  their underlying brain circuits that are modulated with DBS.
                  It proposes principles of pathological network synchronization
                  patterns like beta activity (13-35 Hz) in Parkinson's disease.
