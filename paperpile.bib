@BOOK{Hawkins2004-pe,
  title     = {On Intelligence},
  author    = {Hawkins, Jeff and Blakeslee, Sandra},
  publisher = {Henry Holt and Company},
  date      = {2004-10-03},
  pagetotal = {261},
  abstract  = {From the inventor of the PalmPilot comes a new and compelling
               theory of intelligence, brain function, and the future of
               intelligent machinesJeff Hawkins, the man who created the
               PalmPilot, Treo smart phone, and other handheld devices, has
               reshaped our relationship to computers. Now he stands ready to
               revolutionize both neuroscience and computing in one stroke, with
