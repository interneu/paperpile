@ARTICLE{Cisek2024-tm,
  title        = {Toward a neuroscience of natural behavior},
  author       = {Cisek, Paul and Green, Andrea M},
  journaltitle = {Curr. Opin. Neurobiol.},
  volume       = {86},
  pages        = {102859},
  date         = {2024-04-06},
  abstract     = {One of the most exciting new developments in systems
                  neuroscience is the progress being made toward
                  neurophysiological experiments that move beyond simplified
                  laboratory settings and address the richness of natural
                  behavior. This is enabled by technological advances such as
                  wireless recording in freely moving animals, automated
