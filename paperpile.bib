                  linear models and allow analysis of complex time course data.
                  Thus, the ISC-SM analysis extends traditional subsequent
                  memory findings to a rich, dynamic and more ecologically valid
                  situation.},
  language     = {en}
}

@ARTICLE{Honey2012-un,
  title        = {Slow cortical dynamics and the accumulation of information
                  over long timescales},
  author       = {Honey, Christopher J and Thesen, Thomas and Donner, Tobias H
