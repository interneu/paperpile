@ARTICLE{Lavita2016-bg,
  title        = {The Role of β-Carboline Alkaloids in the Pathogenesis of
                  Essential Tremor},
  author       = {Laviță, Svetlana Iuliana and Aro, Rania and Kiss, Béla and
                  Manto, Mario and Duez, Pierre},
  journaltitle = {Cerebellum},
  volume       = {15},
  issue        = {3},
  pages        = {276--284},
  date         = {2016-06-01},
  abstract     = {Essential tremor (ET) is one of the most prevalent
                  neurological disorders in the world. Environmental factors
                  have been implicated in the pathogenesis of ET. In particular,
                  epidemiological studies have suggested that neurotoxic agents,
                  especially β-carboline alkaloids (βCAs), might be generated
                  through Maillard-type reaction. βCAs are molecules which are
                  members of a large group of heterocyclic amines (HCAs, the
                  so-called products of cooking meat). βCAs are highly
                  tremorogenic in animals, producing a marked generalized action
                  tremor soon after systemic administration in a wide range of
                  laboratory animals such as mice, rats and monkeys.
                  Administration of βCAs remains currently the main experimental
                  model of ET. We review the pathogenesis of ET, with a focus on
                  the biochemistry of βCAs, their occurrence and biological
                  activity, their endogenous biosynthesis, their formation in
                  food, their toxicokinetics and their neurotoxicity. We
                  highlight open questions regarding the effects of βCAs in
                  humans.}
}

