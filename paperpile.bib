                  deficits.},
  language     = {en}
}

@ARTICLE{Kim2020-zd,
  title        = {Medical management for secondary stroke prevention},
  author       = {Kim, Anthony S},
  journaltitle = {Continuum (Minneap. Minn.)},
  publisher    = {Ovid Technologies (Wolters Kluwer Health)},
