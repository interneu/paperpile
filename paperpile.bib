@ARTICLE{Petry-Schmelzer2020-mv,
  title        = {Selecting the Most Effective {DBS} Contact in Essential Tremor
                  Patients Based on Individual Tractography},
  author       = {Petry-Schmelzer, Jan Niklas and Dembek, Till A and Steffen,
