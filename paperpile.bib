  journaltitle = {J. Prev. Med. Hyg.},
  volume       = {56},
  issue        = {1},
  pages        = {E1--8},
  date         = {2015},
  abstract     = {In modern society, a potentially serious adverse event
                  attributed to a vaccination is likely to be snapped up by the
                  media, particularly newspapers and television, as it appeals
                  to the emotions of the public. The widespread news of the
                  alleged adverse events of vaccination has helped to create the
