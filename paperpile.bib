@ARTICLE{Chekroud2014-pd,
  title        = {{A review of neuroimaging studies of race-related prejudice:
                  does amygdala response reflect threat?}},
  author       = {Chekroud, Adam M and Everett, Jim A C and Bridge, Holly and
