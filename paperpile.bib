@ARTICLE{Harbishettar2005-qd,
  title        = {Is there a relationship between Parkinson's disease and
                  obsessive-compulsive disorder?},
  author       = {Harbishettar, Vijaykumar and Pal, Pramod Kumar and Janardhan
                  Reddy, Y C and Thennarasu, K},
  journaltitle = {Parkinsonism Relat. Disord.},
