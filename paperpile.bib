@ARTICLE{Santhakumar2006-wd,
  title        = {Contributions of the {GABAA} Receptor α6 Subunit to Phasic and
                  Tonic Inhibition Revealed by a Naturally Occurring
                  Polymorphism in the α6 Gene},
  author       = {Santhakumar, Vijayalakshmi and Jacob Hanchar, H and Wallner,
                  Martin and Olsen, Richard W and Otis, Thomas S},
  journaltitle = {J. Neurosci.},
  publisher    = {Society for Neuroscience},
  volume       = {26},
  issue        = {12},
  pages        = {3357--3364},
  date         = {2006-03-22},
  abstract     = {GABAA receptors (GABARs) are heteromultimeric proteins
                  composed of five subunits. The specific subunit composition
                  determines critical properties of a GABAR such as
                  pharmacological sensitivities and whether the receptor
                  contributes to synaptic or extrasynaptic forms of inhibition.
                  Classically, synaptic but not extrasynaptic GABARs are thought
                  to respond to benzodiazepines, whereas the reverse has been
