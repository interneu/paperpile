  issue        = {11},
  pages        = {1186--1192},
  date         = {2014},
  abstract     = {The role of distinct limbic areas in emotion regulation has
                  been largely inferred from neuroimaging studies. Recently, the
                  opportunity for intracranial recordings from limbic areas has
                  arisen in patients undergoing deep brain stimulation (DBS) for
                  neuropsychiatric disorders including major depressive disorder
                  (MDD) and obsessive compulsive disorder (OCD). Here we test
                  the hypothesis that distinct temporal patterns of local field
                  potential (LFP) activity in the human limbic system reflect
