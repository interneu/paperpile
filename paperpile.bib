@ARTICLE{Kirschner2021-ha,
  title        = {Neural and behavioral traces of error awareness},
  author       = {Kirschner, Hans and Humann, Jil and Derrfuss, Jan and
                  Danielmeier, Claudia and Ullsperger, Markus},
  journaltitle = {Cogn. Affect. Behav. Neurosci.},
