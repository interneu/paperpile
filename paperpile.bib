}

@ARTICLE{Dorogovtsev2002-mg,
  title        = {{Evolution of networks}},
  author       = {Dorogovtsev, S N and Mendes, J F F},
  journaltitle = {Adv. Phys.},
  publisher    = {Taylor \& Francis},
