@ARTICLE{Perez2017-ab,
  title        = {Brain-to-brain entrainment: {EEG} interbrain synchronization
                  while speaking and listening},
  author       = {Pérez, Alejandro and Carreiras, Manuel and Duñabeitia, Jon
                  Andoni},
  journaltitle = {Sci. Rep.},
