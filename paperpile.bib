}

@ARTICLE{Coles2005-vm,
  title        = {Not just right experiences and obsessive-compulsive features:
                  Experimental and self-monitoring perspectives},
  author       = {Coles, Meredith E and Heimberg, Richard G and Frost, Randy O
                  and Steketee, Gail},
  journaltitle = {Behav. Res. Ther.},
  volume       = {43},
  issue        = {2},
  pages        = {153--167},
  date         = {2005-02},
  abstract     = {Individuals with obsessive-compulsive disorder (OCD) often
                  report compulsions aimed at reducing feelings of something not
                  being just right or sensations of incompleteness. Research
                  using self-report questionnaires has demonstrated a link
                  between not just right experiences (NJREs) and OCD symptoms
                  (Behav. Res. Therapy 41 (2003) 681; Anxiety, 1 (1995) 208).
                  Extending previous work, this paper presents experimental and
                  self-monitoring data on NJREs in an undergraduate sample.
                  NJREs produced distress and urges to change something, but
                  feared consequences were rare. Stronger responses were found
                  for naturally occurring self-monitored NJREs compared to NJREs
                  elicited in the laboratory. Several significant relationships
                  were found between features of NJREs and OC symptoms and
                  constructs theoretically related to OCD (e.g., responsibility,
                  incompleteness), but no significant relationships were found
                  between features of NJREs and non-OCD-related constructs
                  (worry, depressive symptoms, social anxiety). Further
                  consideration of NJREs will be useful in improving our
                  understanding of the phenomenology, neurobiological
                  substrates, and treatment, of OCD. (PsycInfo Database Record
                  (c) 2020 APA, all rights reserved)}
}

@ARTICLE{Coles2003-rh,
  title        = {"Not just right experiences": perfectionism,
                  obsessive-compulsive features and general psychopathology},
  author       = {Coles, Meredith E and Frost, Randy O and Heimberg, Richard G
                  and Rhéaume, Josée},
  journaltitle = {Behav. Res. Ther.},
  volume       = {41},
  issue        = {6},
  pages        = {681--700},
  date         = {2003-06},
  abstract     = {Individuals with obsessive-compulsive disorder (OCD)
                  frequently report uncomfortable sensations of things not being
                  just right ("not just right experiences"; NJREs) and a need to
                  ritualize until they quiet these sensations. However, very
                  little work has been conducted to empirically examine the
                  nature and characteristics of this phenomenon. In this paper,
                  we present two studies that systematically examine NJREs in
                  large undergraduate samples. In Study 1, NJREs were shown to
                  be related to both OCD features and maladaptive domains of
                  perfectionism. In Study 2, NJREs were again significantly
                  related to OCD features. Further, NJREs were shown to have
                  particularly strong relationships with specific OCD symptom
                  clusters (e.g., checking, ordering). Finally, NJREs were
                  significantly more strongly correlated with features of OCD
                  than symptoms from other domains of psychopathology (e.g.,
                  social anxiety, trait anxiety, worry, depression). General
                  conclusions are drawn, and future directions are discussed.},
  language     = {en}
}

@BOOK{Jackson2009-nx,
