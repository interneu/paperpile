}

@BOOK{Kopenawa2019-ea,
  title     = {A queda do céu: Palavras de um xamã yanomami},
  author    = {Kopenawa, Davi and Albert, Bruce},
  publisher = {Companhia das Letras},
  date      = {2019-05-23},
  pagetotal = {768},
  abstract  = {Relato de xamã Yanomami revela a riqueza e as lutas dos povos da
               floresta em livro de gênero único. Um grande xamã e porta-voz dos
               Yanomami oferece neste livro um relato excepcional, ao mesmo
