}

@ARTICLE{Alagapan2023-ub,
  title        = {Cingulate dynamics track depression recovery with deep brain
                  stimulation},
  author       = {Alagapan, Sankaraleengam and Choi, Ki Sueng and Heisig,
                  Stephen and Riva-Posse, Patricio and Crowell, Andrea and
                  Tiruvadi, Vineet and Obatusin, Mosadoluwa and Veerakumar,
