@ARTICLE{Kubler2022-za,
  title        = {Nucleus basalis of Meynert predicts cognition after deep brain
                  stimulation in Parkinson's disease},
  author       = {Kübler, Dorothee and Wellmann, Sophie Katharina and Kaminski,
                  Jakob and Skowronek, Cornelia and Schneider, Gerd-Helge and
