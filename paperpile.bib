  volume       = {254},
  issue        = {4},
  pages        = {IV49--IV53},
  date         = {2007-08-01},
  abstract     = {Parkinson's disease (PD) is thought to be primarily a disorder
                  of the motor system due to dysfunction of the nigrostriatal
                  dopaminergic system. However, recent studies have revealed
                  that social cognition tasks, such as mind-reading, facial
