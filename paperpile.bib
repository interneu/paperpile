@ARTICLE{Jareczek2017-ch,
  title        = {The origins and persistence of psychosurgery in the state of
                  Iowa},
  author       = {Jareczek, Francis J and Holland, Marshall T and Howard, 3rd,
                  Matthew A and Walch, Timothy and Abel, Taylor J},
  journaltitle = {Neurosurg. Focus},
