  language     = {en}
}

@ARTICLE{Le_Heron2018-cc,
  title        = {Distinct effects of apathy and dopamine on effort-based
                  decision-making in Parkinson's disease},
  author       = {Le Heron, Campbell and Plant, Olivia and Manohar, Sanjay and
