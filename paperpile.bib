@ARTICLE{Heinrichs-Graham2017-yv,
  title        = {The cortical signature of symptom laterality in Parkinson's
                  disease},
  author       = {Heinrichs-Graham, Elizabeth and Santamaria, Pamela M and
                  Gendelman, Howard E and Wilson, Tony W},
  journaltitle = {Neuroimage Clin},
  volume       = {14},
  pages        = {433--440},
  date         = {2017-02-12},
  abstract     = {Patients with Parkinson's disease (PD) often present with
                  unilateral motor symptoms that eventually spread to the other
                  side. This symptom lateralization is diagnostically important,
                  as it serves to distinguish PD from other motor disorders with
                  overlapping symptom profiles. Further, recent studies have
                  shown that the side of symptom onset is important for
                  prognosis, as there are differences in the rate of disease
                  progression and the incidence of secondary symptoms between
                  right- and left-dominant (RD, LD) patients. Physiologically,
                  previous studies have shown asymmetrical decline in structure
                  and metabolism throughout the basal ganglia, although
                  connecting this directly to motor function has been difficult.
                  To identify the neurophysiological basis of symptom laterality
                  in PD, we recorded magnetoencephalography (MEG) during left-
                  and right-hand movement paradigms in patients with PD who
                  exhibited either RD or LD symptomatology. The beta
                  oscillations serving these movements were then imaged using
                  beamforming methods, and we extracted the time series of the
                  peak voxel in the left and right primary motor cortices for
                  each movement. In addition, each patient's symptom asymmetry
                  was quantitated using the Unified Parkinson's Disease Rating
                  Scale (UPDRS), which allowed the relationship between symptom
                  asymmetry and neural asymmetry to be assessed. We found that
                  LD patients had stronger beta suppression during movement, as
                  well as greater post-movement beta rebound compared to
                  patients with RD symptoms, independent of the hand that was
                  moved. Interestingly, the asymmetry of beta activity during
                  right-hand movement uniquely correlated with symptom
                  asymmetry, such that the more LD the symptom profile, the more
                  left-lateralized (i.e., contralateral to movement) the beta
                  response; conversely, the more RD the symptom profile, the
                  more right-lateralized (i.e., ipsilateral to movement) the
                  beta response. This study is the first to directly probe the
                  relationship between symptom asymmetry and the laterality of
                  neural activity during movement in patients with PD, and
                  suggests that LD patients have a fundamentally different and
                  more "healthy" oscillatory pattern relative to RD patients.},
  keywords     = {Asymmetry; ERD; MEG; Magnetoencephalography; Movement
                  disorders; Oscillations},
  language     = {en}
}

@ARTICLE{Im2018-yn,
  title        = {Association of Parkinson’s Disease Symptom Laterality and
                  {123I}-{FP}-{CIT} {SPECT} after Deep Brain Stimulation},
  author       = {Im, Hyung-Jun and Ha, Seunggyun and Choi, Hongyoon and Park,
                  Hye Ran and Park, Kwang Woo and Lee, Dong Soo and Paek, Sun Ha},
  journaltitle = {J. Nucl. Med.},
  publisher    = {Society of Nuclear Medicine},
  volume       = {59},
  issue        = {supplement 1},
  pages        = {629--629},
  date         = {2018-05-01},
  abstract     = {629Aim: Parkinson’s disease (PD) is characterized by a
                  unilateral onset and persisting asymmetry of motor symptoms.
                  The side dominance of motor symptom has been reported to have
                  associations with the cognitive, neuropsychological symptoms
                  and prognosis. Dopamine transporter single photon emission
                  computed tomography (SPECT) using 123I-FP-CIT (FP-CIT SPECT)
                  can be utilized to assess presynaptic dopaminergic neuron loss
                  and assess symptom laterality in PD. However, it has not been
                  studied whether the laterality on FP-CIT SPECT correlates with
                  symptom laterality in PD after deep brain stimulation (DBS),
                  which is an effective treatment for managing refractory motor
                  symptoms. This study was to evaluate the correlation between
                  FP-CIT SPECT and motor symptom in the assessment of laterality
                  after DBS. Methods: Nineteen patients with PD were enrolled
                  prospectively and received bilateral subthalamic nucleus (STN)
                  DBS. The patients underwent FP-CIT SPECT before (baseline,
                  n=19), six months (n=18) and one year (n=11) after DBS, and
                  the clinical scores including Unified Parkinson9s Disease
                  Rating Scale motor part (UPDRS-III) of the patients were
                  assessed at the same points (n=19, 19 and 16 respective). Thus
                  19, 18, 11 patients have both FP-CIT SPECT and clinical scores
                  at baseline, 6 months and 1year after DBS, respectively. The
                  scores of left- and right-sided motor symptom laterality in
                  UPDRS-III were used to assess symptom laterality. A symptom
                  laterality index was calculated as the absolute difference of
                  the left-sided and right sided motor score (left - right) in
                  UPDRS part III during off medication and off DBS state.
                  Positive and negative symptom asymmetry index indicate left
                  and right dominant motor symptom, respectively. FP-CIT SPECT
                  was spatially normalized to the template image and Korean
                  Statistical Probabilistic Anatomical Map (KSPAM) based region
                  of interests (ROI) were used to measure uptakes of both
                  caudoputamen and occipital cortex. Binding potential (BPnd)
                  was calculated as BPnd = (Uspecific- Unonspecific)/
                  Unonspecific, where U represented mean uptake of ROI and
                  uptakes of occipital cortex were regarded as nonspecific
                  binding,Unonspecific. FP-CIT SPECT laterality index were
                  calculated as the ratio of BPnd of left and right caudoputamen
                  (left/right). FP-CIT SPECT laterality index over 1 was
                  considered as left-sided laterality. The association between
                  FP-CIT SPECT and symptom laterality was assessed at baseline,
                  six months and one year after DBS. Results: Eleven, six and
                  two among nineteen patients had left-sided, right-sided and
                  symmetric motor symptom, respectively, before the DBS. Among
                  seventeen patients (two patients with symmetric symptom score
                  at baseline were excluded), there were four and six patients
                  who showed changed symptom laterality at six months and one
                  year after DBS, respectively. The agreement between UPDRS-III
                  and FP-CIT SPECT laterality was good to excellent at baseline,
                  six months and one year after DBS (weighted kappa = 0.742,
                  0.736, and 0.813). Furthermore, symptom and FP-CIT SPECT
                  laterality indices showed significant correlation at baseline,
                  six months, and one year after DBS (correlation coefficient, R
                  = 0.54, 0.58 and 0.69, respectively, Fig 1). Also, changed
                  symptom laterality can be well reflected visually in FP-CIT
                  SPECT (Fig 2). Conclusion: The symptom laterality was well
                  correlated with laterality evaluated by FP-CIT SPECT both
                  before and after DBS. An objective evaluation of laterality
                  using FP-CIT SPECT would be helpful for management of patients
                  with PD especially for adjusting the voltage of electrodes for
                  fine balancing of the asymmetric symptom after DBS. The
                  large-scale study is warranted for validation of this result.},
  urldate      = {2022-03-13},
  language     = {en}
}

@ARTICLE{Steinbach2021-ik,
  title        = {Laterality in Parkinson's disease: a neuropsychological review},
  author       = {Steinbach, Marilyn J and Campbell, Ransom W and DeVore,
                  Benjamin B and Harrison, David W},
  journaltitle = {Appl. Neuropsychol. Adult},
  pages        = {1--15},
  date         = {2021-04-12},
  abstract     = {Laterality of motor symptom onset in Parkinson's disease is
                  both well-known and under-appreciated. Treatment of disorders
                  that have asymmetric pathological features, such as stroke and
                  epilepsy, demonstrate the importance of incorporating
                  hemispheric lateralization and specialization into therapy and
                  care planning. These practices could theoretically extend to
                  Parkinson's disease, providing increased diagnostic accuracy
                  and improved treatment outcomes. Additionally, while motor
                  symptoms have generally received the majority of attention,
                  non-motor features (e.g., autonomic dysfunction) also decrease
                  quality of life and are influenced by asymmetrical
                  neurodegeneration. Due to the laterality of cognitive and
                  behavioral processes in the two brain hemispheres, analysis of
                  hemibody side of onset can potentially give insight into
                  expected symptom profile of the patient and allow for
                  increased predictive accuracy of disease progression and
                  outcome, thus opening the door to personalized and improved
                  therapy in treating Parkinson's disease patients. This review
                  discusses motor and non-motor symptoms (namely autonomic,
                  sensory, emotional, and cognitive dysfunction) of Parkinson's
                  disease in respect to hemispheric lateralization from a
                  theoretical perspective in hopes of providing a framework for
                  future research and personalized treatment.},
  keywords     = {Cerebral asymmetry; Parkinson’s disease; autonomic nervous
                  system; cerebral laterality; emotion theory},
  language     = {en}
}

