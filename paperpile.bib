@ARTICLE{Mahony2022-qz,
  title        = {{IQ} Modulates Coupling Between Diverse Dimensions of
                  Psychopathology in Children and Adolescents},
  author       = {Mahony, Bridget W and Tu, Danni and Rau, Srishti and Liu,
