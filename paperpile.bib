  journaltitle = {Neuroimage},
  pages        = {119677},
  date         = {2022-10-13},
  abstract     = {The transition to technologically-assisted communication has
                  permeated all facets of human social life; yet, its impact on
                  the social brain is still unknown and the effects may be
                  particularly intense during periods of developmental
                  transitions. Applying a two-brain perspective, the current
