}

@ARTICLE{Schartner2017-xn,
  title        = {{Increased spontaneous MEG signal diversity for psychoactive
                  doses of ketamine, LSD and psilocybin}},
  author       = {Schartner, Michael M and Carhart-Harris, Robin L and Barrett,
