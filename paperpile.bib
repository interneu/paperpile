@BOOK{Hari2019-lb,
  title     = {Lost Connections: Why You're Depressed and How to Find Hope},
  author    = {Hari, Johann},
  publisher = {Bloomsbury Publishing Plc},
  date      = {2019-01-02},
  pagetotal = {416},
  abstract  = {What really causes depression and anxiety - and how can we really
