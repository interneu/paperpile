@ARTICLE{Subramanian2017-jb,
  title        = {Basal ganglia and autism - a translational perspective},
  author       = {Subramanian, Krishna and Brandenburg, Cheryl and Orsati,
                  Fernanda and Soghomonian, Jean-Jacques and Hussman, John P and
