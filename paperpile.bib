  date         = {2005-05},
  abstract     = {Concepts are the elementary units of reason and linguistic
                  meaning. They are conventional and relatively stable. As such,
                  they must somehow be the result of neural activity in the
                  brain. The questions are: Where? and How? A common
                  philosophical position is that all concepts-even concepts
                  about action and perception-are symbolic and abstract, and
                  therefore must be implemented outside the brain's
                  sensory-motor system. We will argue against this position
                  using (1) neuroscientific evidence; (2) results from neural
                  computation; and (3) results about the nature of concepts from
                  cognitive linguistics. We will propose that the sensory-motor
                  system has the right kind of structure to characterise both
                  sensory-motor and more abstract concepts. Central to this
                  picture are the neural theory of language and the theory of
                  cogs, according to which, brain structures in the
                  sensory-motor regions are exploited to characterise the
                  so-called "abstract" concepts that constitute the meanings of
                  grammatical constructions and general inference patterns.},
  language     = {en}
}

