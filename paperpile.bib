  issue        = {1},
  pages        = {14--28},
  date         = {1985-06-01},
  abstract     = {Corticosubthalamic projections in the rat were investigated
                  using the autoradiographic anterograde axonal tracing
                  technique. After unilateral injections of tritiated amino
                  acids in the cerebral cortex, projections to the ipsilateral
                  subthalamic nucleus (STH) could be found arising only from the
