}

@ARTICLE{Onen2018-fc,
  title        = {{Hypertrophic Olivary Degeneration: Neurosurgical Perspective
                  and Literature Review}},
  author       = {Onen, Mehmet Resid and Moore, Kelli and Cikla, Ulas and Ucer,
                  Melih and Schmidt, Bradley and Field, Aaron S and Baskaya,
                  Mustafa K},
  journaltitle = {World Neurosurg.},
  date         = {2018},
  abstract     = {Introduction Hypertrophic olivary degeneration (HOD) occurs as
                  a result of posterior fossa or brainstem lesions that disrupt
                  the dentato-rubro-olivary tract, well known as the
                  Guillain-Mollaret triangle. Clinical and radiological
                  hallmarks of this condition are palatal myoclonus and T2
                  hyperintensity of the inferior olivary complex on MRI,
                  respectively. Since symptomatic HOD may complicate the
                  recovery of patients with posterior fossa or brainstem
                  lesions, the purpose of this study is to evaluate clinical and
                  imaging findings of patients with HOD. Material and method
                  Sixteen patients (8 female and 8 male) with a mean age of 40.7
                  (range:5-83) years were included in this study based on
                  clinical symptoms and MRI findings. Results We reviewed the
                  clinical and imaging findings of 16 cases of HOD at our
                  institution. Seven (43.7\%) patients had posterior fossa
                  tumors, 6 (37.5\%) patients had cavernoma, 2 patients (12.5\%)
                  sustained traumatic brain injury, and only one (6.2\%) patient
                  presented with cerebellar infarction. Posterior fossa surgery
                  was performed in 13 (81.2\%) of these patients. HOD was
                  detected mean 7.2 (range: 0.5-18) months following surgery or
                  primary neurological insult. Unilateral HOD was observed in 10
                  (62.5\%) cases, while bilateral HOD was observed in only 6
                  (37.5\%) cases. Seven cases (43.7\%) were asymptomatic from
                  HOD, whereas 5 (31.2\%) had symptoms attributable to HOD. Two
                  patients died due to primary tumors, although mean follow-up
                  after detection of HOD on MRI was 52.2 (range: 1-120) months
                  in the remaining 14 cases. In these cases, no change in
                  clinical symptoms or imaging findings was detected during
                  follow-up. Conclusion In this series, posterior fossa tumors
                  and cavernomas were the most common etiology of HOD. Although
                  most of the patients with HOD remained asymptomatic, HOD
                  complicated the course of recovery in almost one quarter of
                  the patients included in this study. Neurosurgeons should be
                  aware of HOD, which has characteristic clinical and imaging
                  findings, and may complicate the recovery of patients with
                  disruption to the dentato-rubro-olivary tract.}
}

@ARTICLE{Ondo2003-sk,
  title        = {{Flumazenil, a GABA antagonist, may improve features of
                  Parkinson's disease}},
  author       = {Ondo, William G and Hunter, Christine},
  journaltitle = {Mov. Disord.},
  volume       = {18},
  issue        = {6},
  pages        = {683--685},
  date         = {2003},
  abstract     = {Manipulation of γ-aminobutyrate (GABA) system has been little
                  studied in Parkinson's disease, despite the fact that GABA
                  subserves a large part of the basal ganglia, including the
                  outflow tracts. To test whether antagonism of GABA could
                  improve features of PD, we administered open label intravenous
                  flumazenil to eight practically defined off patients and
                  assessed UPDRS scores, bilateral 1-minute hand-tapping speed,
                  and timed gait tests. Patients demonstrated significantly
                  greater tapping speed, which peaked 40 minutes after injection
                  (P < 0.05). Total motor Unified Parkinson's Disease Rating
                  Scale scores modestly improved (P < 0.05). There were no
                  adverse events. Mechanisms by which flumazenil could improve
                  PD are discussed. © 2003 Movement Disorder Society}
}

