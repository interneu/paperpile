  author       = {Barrett, Lisa Feldman and Quigley, Karen S and Hamilton, Paul},
  journaltitle = {Philos. Trans. R. Soc. Lond. B Biol. Sci.},
  publisher    = {royalsocietypublishing.org},
  volume       = {371},
  issue        = {1708},
  date         = {2016-11-19},
  abstract     = {In this paper, we integrate recent theoretical and empirical
                  developments in predictive coding and active inference
                  accounts of interoception (including the Embodied Predictive
                  Interoception Coding model) with working hypotheses from the
                  theory of constructed emotion to propose a biologically
                  plausible unified theory of the mind that places metabolism
