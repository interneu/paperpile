@ARTICLE{Vlaskamp2017-iq,
  title        = {Auditory processing in autism spectrum disorder: Mismatch
                  negativity deficits},
  author       = {Vlaskamp, Chantal and Oranje, Bob and Madsen, Gitte Falcher
