@BOOK{Snowden2019-pz,
  title     = {Epidemics and Society: From the Black Death to the Present},
  author    = {Snowden, Frank M},
  publisher = {Yale University Press},
  date      = {2019-10-22},
  pagetotal = {512},
  abstract  = {A wide-ranging study that illuminates the connection between
               epidemic diseases and societal change, from the Black Death to
