  journaltitle = {Clin. Neurophysiol.},
  volume       = {127},
  issue        = {9},
  pages        = {2985--2989},
  date         = {2016-09},
  abstract     = {OBJECTIVE: To investigate whether the somatosensory temporal
                  discrimination threshold (STDT) is already altered at the
