  journaltitle = {Strategic Change},
  volume       = {29},
  issue        = {3},
  pages        = {301--309},
  date         = {2020},
  abstract     = {Technological and organizational constraints hinder
                  entrepreneurial ability in alertly selecting/exploiting new
                  opportunities. This article aims at showing that the
                  complexity of the environment shapes entrepreneurial
                  alertness. We build an experiment to mimic the choice
                  alertness process (a case of eustress) and measure alertness
                  and its relations with opportunity appearances,
                  entrepreneurial effort, and complexity of the production
                  structure. We show that alertness increases with the selection
