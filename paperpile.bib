  journaltitle = {https://psyarxiv.com › ...https://psyarxiv.com › ...},
  date         = {2022-10},
  abstract     = {The perception of body signals play a crucial role in
                  cognition and emotion, which may lead to catastrophic outcomes
                  when it becomes dysfunctional. To characterize these
