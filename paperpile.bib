  author       = {Petracca, Enrico},
  journaltitle = {Econ. Philos.},
  publisher    = {Cambridge University Press (CUP)},
  pages        = {1--22},
  date         = {2022-07-12},
  abstract     = {Abstract The paper provides a neurophilosophical assessment of
                  a controversy between two neuroeconomic models that compete to
                  identify the putative object of neural utility: goods or
                  actions. We raise two objections to the common view that sees
                  the ‘good-based’ model prevailing over the ‘action-based’
