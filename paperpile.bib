  journaltitle = {arXiv},
  date         = {2014},
  abstract     = {Recently proposed neural network activation functions such as
                  rectified linear, maxout, and local winner-take-all have
                  allowed for faster and more effective training of deep neural
                  architectures on large and complex datasets. The common trait
                  among these functions is that they implement local competition
                  between small groups of computational units within a layer, so
