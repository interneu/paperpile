  pages        = {449--464},
  date         = {2011},
  abstract     = {Higher-order executive tasks such as learning, working memory,
                  and behavioral flexibility depend on the prefrontal cortex
                  (PFC), the brain region most elaborated in primates. The
                  prominent innervation by serotonin neurons and the dense
