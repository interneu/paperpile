}

@ARTICLE{Gurney2015-gz,
  title        = {A new framework for cortico-striatal plasticity: behavioural
                  theory meets in vitro data at the reinforcement-action
                  interface},
  author       = {Gurney, Kevin N and Humphries, Mark D and Redgrave, Peter},
