}

@ARTICLE{Teodoro2020-yj,
  title        = {{Contingent negative variation: a biomarker of abnormal
                  attention in functional movement disorders}},
  author       = {Teodoro, T and Koreki, A and Meppelink, A M and Little, S and
                  Nielsen, G and Macerollo, A and Ferreira, J J and Pareés, I
