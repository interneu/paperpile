@ARTICLE{Lagrand2024-mf,
  title        = {A Critical Appraisal of the Whack-a-Mole and Swivel Chair
                  Signs in the Diagnosis of Functional Movement Disorders},
  author       = {Lagrand, Tjerk J and Brusse-Keizer, Marjolein and Charmley,
                  Andrew and Edwards, Mark J and Tijssen, Marina A J and Lehn,
