  journaltitle = {Mov. Disord.},
  volume       = {24},
  issue        = {1},
  pages        = {57--63},
  date         = {2009},
  abstract     = {Deep brain stimulation (DBS) of the subthalamic nucleus (STN)
                  has been shown to be an effective treatment for Parkinson's
                  disease (PD). The intraoperative positioning of DBS electrodes
                  and postoperative adjustment of the stimulation parameters,
                  however, require continuous, precise evaluation. Moreover,
                  ambulatory measurements of the symptoms would also help to
                  evaluate changes in the progression of PD in these patients.
                  To this aim, we objectified rigidity measurements via surface
                  EMG recordings of the Mm. biceps (bic) and triceps brachii
                  (tric) in patients treated with chronic stimulation of the
