@ARTICLE{Akram2018-ph,
  title        = {{Connectivity derived thalamic segmentation in deep brain
                  stimulation for tremor}},
  author       = {Akram, Harith and Dayal, Viswas and Mahlknecht, Philipp and
                  Georgiev, Dejan and Hyam, Jonathan and Foltynie, Thomas and
