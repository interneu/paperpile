}

@ARTICLE{Zhang2019-xu,
  title        = {The Dynamics of Belief Updating in Human Cooperation: Findings
                  from inter-brain {ERP} hyperscanning},
  author       = {Zhang, Dandan and Lin, Yiqin and Jing, Yiming and Feng,
