  pages        = {320--331},
  date         = {2007-07},
  abstract     = {In 1870 Gustav Fritsch and Edvard Hitzig showed that
                  electrical stimulation of the cerebral cortex of a dog
                  produced movements. This was a crucial event in the
                  development of modern neuroscience because it was the first
                  good experimental evidence for a) cerebral cortex involvement
