}

@ARTICLE{Oberto2022-um,
  title        = {Distributed cell assemblies spanning prefrontal cortex and
                  striatum},
  author       = {Oberto, Virginie J and Boucly, Céline J and Gao, Hongying and
                  Todorova, Ralitsa and Zugaro, Michaël B and Wiener, Sidney I},
  journaltitle = {Curr. Biol.},
  volume       = {32},
  issue        = {1},
  pages        = {1--13.e6},
  date         = {2022-01-10},
  abstract     = {Highly synchronous neuronal assembly activity is deemed
                  essential for cognitive brain function. In theory, such
                  synchrony could coordinate multiple brain areas performing
                  complementary processes. However, cell assemblies have been
                  observed only in single structures, typically cortical areas,
                  and little is known about their synchrony with downstream
