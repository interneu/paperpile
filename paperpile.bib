  date         = {2018},
  abstract     = {Earlier research has yielded contradictory results as to the
                  main drivers of environmentally significant behavior.
                  Intent-oriented research has stressed the importance of
                  motivational aspects, while impact-oriented research has drawn
                  attention to people’s socioeconomic status. In this study, we
                  investigated the diverging role of a pro-environmental stance
