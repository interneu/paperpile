@ARTICLE{Shimegi2016-uu,
  title        = {{Cholinergic and serotonergic modulation of visual information
                  processing in monkey {V1}}},
  author       = {Shimegi, Satoshi and Kimura, Akihiro and Sato, Akinori and
                  Aoyama, Chisa and Mizuyama, Ryo and Tsunoda, Keisuke and Ueda,
