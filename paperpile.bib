}

@ARTICLE{Preller2017-mp,
  title        = {{The Fabric of Meaning and Subjective Effects in LSD-Induced
                  States Depend on Serotonin 2A Receptor Activation}},
  author       = {Preller, Katrin H and Herdener, Marcus and Pokorny, Thomas and
