  author       = {Clark, Andy},
  journaltitle = {Behav. Brain Sci.},
  volume       = {36},
  issue        = {3},
  pages        = {181--204},
  date         = {2013},
  abstract     = {Brains, it has recently been argued, are essentially
                  prediction machines. They are bundles of cells that support
                  perception and action by constantly attempting to match
                  incoming sensory inputs with top-down expectations or
                  predictions. This is achieved using a hierarchical generative
                  model that aims to minimize prediction error within a
                  bidirectional cascade of cortical processing. Such accounts
                  offer a unifying model of perception and action, illuminate
