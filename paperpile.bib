  author       = {Vollenweider, Franz X and Preller, Katrin H},
  journaltitle = {Nat. Rev. Neurosci.},
  issue        = {11},
  pages        = {1--14},
  date         = {2020},
  abstract     = {Renewed interest in the use of psychedelics in the treatment
