  journaltitle = {Neuron},
  date         = {2021-09-28},
  abstract     = {The large diversity of neuron types provides the means by
                  which cortical circuits perform complex operations. Neuron can
                  be described by biophysical and molecular characteristics,
                  afferent inputs, and neuron targets. To quantify, visualize,
                  and standardize those features, we developed the open-source,
