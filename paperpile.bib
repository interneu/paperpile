}

@ARTICLE{Muthukumaraswamy2013-ih,
  title        = {{Broadband Cortical Desynchronization Underlies the Human
                  Psychedelic State}},
  author       = {Muthukumaraswamy, Suresh D and Carhart-Harris, Robin L and
                  Moran, Rosalyn J and Brookes, Matthew J and Williams, Tim M
                  and Errtizoe, David and Sessa, Ben and Papadopoulos, Andreas
