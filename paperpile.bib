@ARTICLE{Murray2014-oq,
  title        = {{A hierarchy of intrinsic timescales across primate cortex}},
  author       = {Murray, John D and Bernacchia, Alberto and Freedman, David J
                  and Romo, Ranulfo and Wallis, Jonathan D and Cai, Xinying and
