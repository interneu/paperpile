}

@ARTICLE{Sorkun2018-qi,
  title        = {How do social norms influence recycling behavior in a
                  collectivistic society? A case study from Turkey},
  author       = {Sorkun, Metehan Feridun},
  journaltitle = {Waste Manag.},
