  author       = {Lhommée, Eugénie and Wojtecki, Lars and Czernecki, Virginie
                  and Witt, Karsten and Maier, Franziska and Tonder, Lisa and
                  Timmermann, Lars and Hälbig, Thomas D and Pineau, Fanny and
