@ARTICLE{Civitello2015-co,
  title        = {Biodiversity inhibits parasites: Broad evidence for the
                  dilution effect},
  author       = {Civitello, David J and Cohen, Jeremy and Fatima, Hiba and
                  Halstead, Neal T and Liriano, Josue and McMahon, Taegan A and
                  Ortega, C Nicole and Sauer, Erin Louise and Sehgal, Tanya and
