@ARTICLE{Rutgen2020-ru,
  title    = {{Detached empathic experience of others’ pain in remitted states
              of depression – an fMRI study}},
  author   = {Rütgen, Markus and Pfabigan, Daniela M and Tik, Martin and Kraus,
