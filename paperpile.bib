  author       = {Raja, Vicente and Anderson, Michael L},
  journaltitle = {Ecol. Psychol.},
  volume       = {31},
  issue        = {3},
  pages        = {166--181},
  date         = {2019},
  abstract     = {A radical embodied cognitive neuroscience (RECN) based on
                  ecological psychology requires the understanding of the brain,
                  its structure, and its functions to be compatible with the
                  main tenets of the Gibsonian theory. In this paper, we propose
                  neural reuse as a promising candidate to achieve such
                  understanding. We base our proposal on two fundamental ideas.
                  In section two, we review what we take to be the two central
                  requirements for a RECN based on ecological psychology:
                  compatibility with the explanation of perception and action at
                  the ecological scale and the rejection of computation as a
                  paradigm for the explanation of the activity of the brain. In
