  keywords     = {EEG; Machine learning; Parkinson’s disease; Tremor},
  language     = {en}
}

@ARTICLE{Chang2022-df,
  title        = {Evaluating the Different Stages of Parkinson's Disease Using
                  Electroencephalography With Holo-Hilbert Spectral Analysis},
  author       = {Chang, Kuo-Hsuan and French, Isobel Timothea and Liang,
