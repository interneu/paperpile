@ARTICLE{Hirono2006-py,
  title        = {Alpha-adrenoceptive dual modulation of inhibitory {GABAergic}
                  inputs to Purkinje cells in the mouse cerebellum},
  author       = {Hirono, Moritoshi and Obata, Kunihiko},
