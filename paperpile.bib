@ARTICLE{Najjar2018-yx,
  title        = {{A clinical approach to new-onset psychosis associated with
                  immune dysregulation: the concept of autoimmune psychosis}},
  author       = {Najjar, Souhel and Steiner, Johann and Najjar, Amanda and
