  date         = {2013},
  abstract     = {The descending projections from motor cortex share many
                  features with top-down or backward connections in visual
                  cortex; for example, corticospinal projections originate in
                  infragranular layers, are highly divergent and (along with
                  descending cortico-cortical projections) target cells
