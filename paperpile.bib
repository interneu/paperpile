}

@ARTICLE{Swanson2010-jj,
  title        = {Foundational model of structural connectivity in the nervous
                  system with a schema for wiring diagrams, connectome, and
                  basic plan architecture},
  author       = {Swanson, Larry W and Bota, Mihail},
  journaltitle = {Proc. Natl. Acad. Sci. U. S. A.},
