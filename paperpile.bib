  journaltitle = {Front. Comput. Neurosci.},
  volume       = {14},
  pages        = {571527},
  date         = {2020-10-28},
  abstract     = {Subthalamic nucleus deep brain stimulation (STN-DBS) is an
                  effective invasive treatment for advanced Parkinson's disease
                  (PD) at present. Due to the invasiveness and cost of
                  operations, a reliable tool is required to predict the outcome
                  of therapy in the clinical decision-making process. This work
