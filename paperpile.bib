  date         = {2011},
  abstract     = {Spinocerebellar ataxias 6 and 7 (SCA6 and SCA7) are
                  neurodegenerative disorders caused by expansion of CAG repeats
                  encoding polyglutamine (polyQ) tracts in CACNA1A, the alpha1A
                  subunit of the P/Q-type calcium channel, and ataxin-7 (ATXN7),
