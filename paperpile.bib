  journaltitle = {Schizophr. Res.},
  date         = {2021-08-09},
  abstract     = {Delusions are, by popular definition, false beliefs that are
                  held with certainty and resistant to contradictory evidence.
                  They seem at odds with the notion that the brain at least
                  approximates Bayesian inference. This is especially the case
                  in schizophrenia, a disorder thought to relate to decreased -
