@ARTICLE{Mardones2020-gs,
  title        = {The {COVID}-19 Pandemic and Global Food Security},
  author       = {Mardones, Fernando O and Rich, Karl M and Boden, Lisa A and
                  Moreno-Switt, Andrea I and Caipo, Marisa L and
