@ARTICLE{Pinter2023-gv,
  title        = {The right imaging protocol for the right patient},
  author       = {Pinter, Nandor K},
  journaltitle = {Continuum (Minneap. Minn.)},
  publisher    = {Ovid Technologies (Wolters Kluwer Health)},
  volume       = {29},
  issue        = {1},
  pages        = {16--26},
  date         = {2023-02-01},
  abstract     = {OBJECTIVE: This article provides a high-level overview of the
                  challenge of choosing the right imaging approach for an
