}

@ARTICLE{Bargh2006-lp,
  title        = {The Automaticity of Social Life},
  author       = {Bargh, John A and Williams, Erin L},
  journaltitle = {Curr. Dir. Psychol. Sci.},
  publisher    = {journals.sagepub.com},
  volume       = {15},
  issue        = {1},
  pages        = {1--4},
  date         = {2006-02},
  abstract     = {Much of social life is experienced through mental processes
                  that are not intended and about which one is fairly oblivious.
                  These processes are automatically triggered by features of the
                  immediate social environment, such as the group memberships of
                  other people, the qualities of their behavior, and features of
                  social situations (e.g., norms, one's relative power). Recent
                  research has shown these nonconscious influences to extend
                  beyond the perception and interpretation of the social world
                  to the actual guidance, over extended time periods, of one's
                  important goal pursuits and social interactions.},
  language     = {en}
}

