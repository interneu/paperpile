  pages        = {774--780},
  date         = {2016-12},
  abstract     = {Essential tremor (ET), clinically characterized by postural
                  and kinetic tremors, predominantly in the upper extremities,
                  originates from pathological activity in the dynamic
                  oscillatory network comprising the majority of nodes in the
                  central motor network. Evidence indicates dysfunction in the
