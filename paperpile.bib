  journaltitle = {Brain},
  volume       = {137},
  issue        = {11},
  pages        = {2916--2921},
  date         = {2014},
  abstract     = {Functional movement disorders require attention to manifest
                  yet patients report the abnormal movement to be out of their
                  control. In this study we explore the phenomenon of sensory
                  attenuation, a measure of the sense of agency for movement, in
                  this group of patients by using a force matching task.
                  Fourteen patients and 14 healthy control subjects were
                  presented with forces varying from 1 to 3 N on the index
                  finger of their left hand. Participants were required to match
