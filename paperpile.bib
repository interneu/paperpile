@ARTICLE{Whitmer2012-lm,
  title        = {{High frequency deep brain stimulation attenuates subthalamic
                  and cortical rhythms in Parkinson's disease}},
  author       = {Whitmer, Diane and Solages, Camille de and Hill, Bruce and Yu,
