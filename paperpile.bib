@ARTICLE{Di_Biase2021-pa,
  title        = {Adaptive, personalized closed-loop therapy for Parkinson's
                  disease: biochemical, neurophysiological, and wearable sensing
                  systems},
  author       = {di Biase, Lazzaro and Tinkhauser, Gerd and Martin Moraud,
