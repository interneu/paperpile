@ARTICLE{Keritam2024-zg,
  title        = {A clinical perspective on muscle specific kinase antibody
                  positive myasthenia gravis},
  author       = {Keritam, Omar and Vincent, Prof Angela and Zimprich, Fritz and
                  Cetin, Hakan},
  journaltitle = {Front. Immunol.},
