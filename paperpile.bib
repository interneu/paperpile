  author       = {Milardi, Demetrio and Quartarone, Angelo and Bramanti, Alessia
                  and Anastasi, Giuseppe and Bertino, Salvatore and Basile,
                  Gianpaolo Antonio and Buonasera, Piero and Pilone, Giorgia and
