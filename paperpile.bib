@ARTICLE{Tao2021-es,
  title        = {{Autologous transplant therapy alleviates motor and depressive
                  behaviors in parkinsonian monkeys}},
  author       = {Tao, Yunlong and Vermilyea, Scott C and Zammit, Matthew and
                  Lu, Jianfeng and Olsen, Miles and Metzger, Jeanette M and Yao,
                  Lin and Chen, Yuejun and Phillips, Sean and Holden, James E
                  and Bondarenko, Viktoriya and Block, Walter F and Barnhart,
