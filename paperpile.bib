@ARTICLE{Diez2020-ex,
  title        = {{Early-life trauma endophenotypes and brain circuit–gene
                  expression relationships in functional neurological
                  (conversion) disorder}},
  author       = {Diez, Ibai and Larson, Anna G and Nakhate, Vihang and Dunn,
                  Erin C and Fricchione, Gregory L and Nicholson, Timothy R and
