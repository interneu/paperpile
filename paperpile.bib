@ARTICLE{Confavreux2020-jo,
  title        = {{A meta-learning approach to (re)discover plasticity rules
                  that carve a desired function into a neural network}},
  author       = {Confavreux, Basile and Agnes, Everton J and Zenke, Friedemann
