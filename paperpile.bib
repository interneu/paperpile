@ARTICLE{Parr2017-kf,
  title        = {Working memory, attention, and salience in active inference},
  author       = {Parr, Thomas and Friston, Karl J},
  journaltitle = {Sci. Rep.},
  volume       = {7},
  issue        = {1},
  pages        = {14678},
  date         = {2017-11-07},
  abstract     = {The psychological concepts of working memory and attention are
                  widely used in the cognitive and neuroscientific literatures.
                  Perhaps because of the interdisciplinary appeal of these
                  concepts, the same terms are often used to mean very different
                  things. Drawing on recent advances in theoretical
                  neurobiology, this paper tries to highlight the correspondence
                  between these established psychological constructs and the
                  formal processes implicit in mathematical descriptions of
                  brain function. Here, we consider attention and salience from
                  the perspective offered by active inference. Using variational
                  principles and simulations, we use active inference to
                  demonstrate how attention and salience can be disambiguated in
                  terms of message passing between populations of neurons in
                  cortical and subcortical structures. In brief, we suggest that
                  salience is something that is afforded to actions that realise
                  epistemic affordance, while attention per se is afforded to
                  precise sensory evidence - or beliefs about the causes of
                  sensations.},
  note         = {Friston recommended},
  language     = {en}
}

