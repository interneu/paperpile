  pages        = {1291--1308},
  date         = {2016},
  abstract     = {Structural and functional interconnections of the bilateral
                  central vestibular network have not yet been completely
                  delineated. This includes both ipsilateral and contralateral
                  pathways and crossing sites on the way from the vestibular
                  nuclei via the thalamic relay stations to multiple “vestibular
