  date         = {2014},
  abstract     = {Pyramidal cells of the ventral hippocampal CA1 area have
                  numerous and diverse distant projections to other brain
                  regions including the temporal and parietal association areas,
                  visual, auditory, olfactory, somatosensory, gustatory, and
