  pages        = {1262--1270},
  date         = {2000-06-01},
  abstract     = {Rat cerebellar granule cells were cultured for 5 days with
                  progesterone, resulting in the conversion of progesterone to
                  allopregnanolone, a potent and efficacious modulator of
                  γ-aminobutyric acid (GABA) type-A receptors, as well as in
