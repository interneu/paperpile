  journaltitle = {Neuromodulation},
  volume       = {21},
  issue        = {6},
  pages        = {611--616},
  date         = {2018},
  abstract     = {In closed-loop on-demand control (ODC) of deep brain
                  stimulation (DBS), stimulation is applied only when symptoms
                  appear. Following stimulation of a fixed duration, DBS is
                  switched off until the symptoms reappear. By repeating these
                  demand-driven cycles, the amount of stimulation delivered can
                  be decreased, thereby reducing DBS side-effects and improving
                  battery-life of the pulse-generator. This article introduces
