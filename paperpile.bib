@ARTICLE{Vanegas-Arroyave2016-fd,
  title        = {{Tractography patterns of subthalamic nucleus deep brain
                  stimulation.}},
  author       = {Vanegas-Arroyave, Nora and Lauro, Peter M and Huang, Ling and
                  Hallett, Mark and Horovitz, Silvina G and Zaghloul, Kareem A
