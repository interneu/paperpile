}

@ARTICLE{Neumann2014-dp,
  title        = {{Different patterns of local field potentials from limbic DBS
                  targets in patients with major depressive and obsessive
                  compulsive disorder}},
  author       = {Neumann, W-J and Huebl, J and Brücke, C and Gabriëls, L and
