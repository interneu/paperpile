@ARTICLE{Battaglia2011-vq,
  title        = {Corticomotor Excitability during Observation and Imagination
                  of a Work of Art},
  author       = {Battaglia, Fortunato and Lisanby, Sarah H and Freedberg, David},
  journaltitle = {Front. Hum. Neurosci.},
  volume       = {5},
  pages        = {79},
  date         = {2011-08-23},
  abstract     = {We examine the effects of the artistic representation - here
                  exemplified by Michelangelo's Expulsion from Paradise - of an
                  action on the motor system. Using single and paired- pulse
                  transcranial magnetic stimulation we analyze corticomotor
                  excitability during observation of an action in the painting,
                  during imagery of the painting, and during observation of a
                  photograph of the same pose. We also analyze the effects of
                  observation of two further paintings, one showing the same
                  muscles at rest, and in the other in a more overtly emotional
                  context. Both observation of the Expulsion and of imagery of
