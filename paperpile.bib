}

@ARTICLE{Levin2009-mm,
  title        = {{Objective measurement of muscle rigidity in parkinsonian
                  patients treated with subthalamic stimulation}},
  author       = {Levin, Johannes and Krafczyk, Siegbert and Valkovič, Peter and
