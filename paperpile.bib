  volume       = {5},
  date         = {2016-11-14},
  abstract     = {Categorization has been associated with distributed networks
                  of the primate brain, including the prefrontal cortex (PFC)
                  and posterior parietal cortex (PPC). Although
                  category-selective spiking in PFC and PPC has been
                  established, the frequency-dependent dynamic interactions of
