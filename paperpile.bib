@ARTICLE{Gerster2025-cq,
  title        = {Beyond beta: Aperiodic broadband power reflects Parkinson’s
                  disease severity–a multicenter study},
  author       = {Gerster, Moritz and Waterstraat, Gunnar and Binns, Thomas S
