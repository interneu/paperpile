  author       = {Colombo, Matteo and Wright, Cory},
  journaltitle = {Brain Cogn.},
  volume       = {112},
  pages        = {3--12},
  date         = {2017},
  abstract     = {Courtesy of its free energy formulation, the hierarchical
                  predictive processing theory of the brain (PTB) is often
                  claimed to be a grand unifying theory. To test this claim, we
                  examine a central case: activity of mesocorticolimbic
                  dopaminergic (DA) systems. After reviewing the three most
