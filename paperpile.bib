}

@ARTICLE{Taylor2022-ma,
  title        = {The Contribution of Noradrenergic Activity to Anxiety-Induced
                  Freezing of Gait},
  author       = {Taylor, Natasha L and Wainstein, Gabriel and Quek, Dione and
                  Lewis, Simon J G and Shine, James M and Ehgoetz Martens,
