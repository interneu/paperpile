  journaltitle = {Frontiers in Ecology and Evolution},
  volume       = {9},
  date         = {2021},
  abstract     = {Metaphors have formed a significant part of the development of
                  neuroscience, often linked with technology. A metaphor that
                  has been widely used for the past two centuries is that of the
                  nervous system being like wires, either as a telegraph system
                  or telephone exchange, or, more recently, in the more abstract
