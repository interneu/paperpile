  pages        = {192--207},
  date         = {2017-06-01},
  abstract     = {Human intelligence has been conceptualized as a complex system
                  of dissociable cognitive processes, yet studies investigating
                  the neural basis of intelligence have typically emphasized the
                  contributions of discrete brain regions or, more recently, of
                  specific networks of functionally connected regions. Here we
                  take a broader, systems perspective in order to investigate
