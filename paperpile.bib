  pages        = {11281--11295},
  date         = {2013},
  abstract     = {The mechanisms by which the human brain controls eye movements
                  are reasonably well understood, but those for the head less
                  so. Here, we show that the mechanisms for keeping the head
                  aimed at a stationary target follow strategies similar to
                  those for holding the eyes steady on stationary targets.
