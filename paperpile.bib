}

@ARTICLE{Hanzlikova2019-kl,
  title        = {{Prepulse inhibition of the blink reflex is abnormal in
                  functional movement disorders}},
  author       = {Hanzlíková, Zuzana and Kofler, Markus and Slovák, Matěj and
                  Věchetová, Gabriela and Fečíková, Anna and Kemlink, David and
