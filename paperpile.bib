@ARTICLE{Sarasso2021-gi,
  title        = {Nice and easy: Mismatch negativity responses reveal a
                  significant correlation between aesthetic appreciation and
                  perceptual learning},
  author       = {Sarasso, Pietro and Neppi-Modona, Marco and Rosaia, Nicola and
                  Perna, Pasqualina and Barbieri, Paolo and Del Fante, Elena and
