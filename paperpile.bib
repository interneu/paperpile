}

@ARTICLE{Treven2018-gu,
  title        = {Towards functional selectivity for α6β3γ2 {GABAA} receptors: a
                  series of novel pyrazoloquinolinones},
  author       = {Treven, Marco and Siebert, David C B and Holzinger, Raphael
                  and Bampali, Konstantina and Fabjan, Jure and Varagic, Zdravko
                  and Wimmer, Laurin and Steudle, Friederike and Scholze, Petra
