@ARTICLE{Borzi2019-wm,
  title        = {{Home monitoring of motor fluctuations in Parkinson’s disease
                  patients}},
  author       = {Borzì, Luigi and Varrecchia, Marilena and Olmo, Gabriella and
                  Artusi, Carlo Alberto and Fabbri, Margherita and Rizzone,
                  Mario Giorgio and Romagnolo, Alberto and Zibetti, Maurizio and
                  Lopiano, Leonardo},
  journaltitle = {Journal of Reliable Intelligent Environments},
  pages        = {1--18},
  date         = {2019},
  abstract     = {In Parkinson’s disease, motor fluctuations (worsening of
                  tremor, bradykinesia, freezing of gait, postural instability)
                  affect up to 70\% of patients within 9 years of L-dopa
                  therapy. Nevertheless, the assessment of motor fluctuations is
                  difficult in a medical office, and is commonly based on poorly
                  reliable self-reports. Hence, the use of wearable sensors is
                  desirable. In this preliminary trial, we have investigated
