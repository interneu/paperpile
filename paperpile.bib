                  attribution.}
}

@ARTICLE{Preller2016-np,
  title        = {{Effects of serotonin 2A/1A receptor stimulation on social
                  exclusion processing}},
  author       = {Preller, Katrin H and Pokorny, Thomas and Hock, Andreas and
