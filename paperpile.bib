  pages        = {443--464},
  date         = {2014-11},
  abstract     = {About a decade ago, psychology of the arts started to gain
                  momentum owing to a number of drives: technological progress
                  improved the conditions under which art could be studied in
                  the laboratory, neuroscience discovered the arts as an area of
                  interest, and new theories offered a more comprehensive look
