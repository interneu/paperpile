  journaltitle = {Continuum},
  volume       = {24},
  issue        = {6},
  pages        = {1753--1775},
  date         = {2018},
  abstract     = {Weakness is a common reason patients are seen in neurologic
                  consultation. This article reviews the differential diagnosis
