  journaltitle = {Nat. Commun.},
  volume       = {11},
  issue        = {1},
  pages        = {3035},
  date         = {2020},
  abstract     = {Complex human cognition arises from the integrated processing
                  of multiple brain systems. However, little is known about how
                  brain systems and their interactions might relate to, or
                  perhaps even explain, human cognitive capacities. Here, we
                  address this gap in knowledge by proposing a mechanistic
                  framework linking frontoparietal system activity, default mode
