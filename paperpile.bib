                  neurodegen diseases - cited by Taylor and Shine},
  keywords     = {connectome; economy; small world; workspace},
  language     = {en}
}

@ARTICLE{Debove2023-ks,
  title        = {Deep Brain Stimulation: When to Test Directional?},
